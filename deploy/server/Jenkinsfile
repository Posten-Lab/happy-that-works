pipeline {
  agent {
    kubernetes {
      yaml '''
apiVersion: v1
kind: Pod
spec:
  serviceAccountName: jenkins
  nodeSelector: { site: onprem2 }
  tolerations:
    - { key: dedicated, operator: Equal, value: ci, effect: NoSchedule }
  containers:
    - name: jnlp
      image: ahmadposten/jenkins-agent-kubectl:latest
      resources:
        requests: { cpu: "200m", memory: "512Mi" }
        limits: { cpu: "1", memory: "1Gi" }
    - name: node
      image: node:20-bookworm
      securityContext: { runAsUser: 1000, runAsGroup: 1000 }
      command: ["cat"]
      tty: true
      resources:
        requests: { cpu: "6", memory: "6Gi" }
        limits: { cpu: "16", memory: "16Gi" }
    - name: kaniko
      image: gcr.io/kaniko-project/executor:debug
      command: ["/busybox/cat"]
      tty: true
      volumeMounts:
        - { name: dockerhub, mountPath: /kaniko/.docker }
      resources:
        requests: { cpu: "16", memory: "8Gi", ephemeral-storage: "20Gi" }
        limits: { cpu: "48", memory: "24Gi", ephemeral-storage: "60Gi" }
  volumes:
    - name: dockerhub
      secret: { secretName: dockerhub-credentials }
'''
      defaultContainer 'node'
    }
  }
  options {
    timeout(time: 90, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '20'))
    disableConcurrentBuilds()
    skipDefaultCheckout()
  }
  triggers { githubPush() }
  parameters {
    booleanParam(name: 'VALIDATE_ONLY', defaultValue: false,
      description: 'Run production configuration and tests without publishing an image or deploying.')
  }
  environment {
    APP_ENV = 'production'
    CI = '1'
    SHARP_IGNORE_GLOBAL_LIBVIPS = '1'
    EXPO_PUBLIC_TALOS_SERVER_URL = 'https://api.talosapp.ai'
    EXPO_PUBLIC_TALOS_WEBAPP_URL = 'https://talosapp.ai'
    EXPO_PUBLIC_TALOS_INSTALL_COMMAND = 'npm install -g talosapp'
    COREPACK_HOME = '/tmp/corepack'
    PATH = "${WORKSPACE}/.ci-bin:${PATH}"
  }
  stages {
    stage('Checkout') {
      options { retry(3) }
      steps {
        script {
          // Keep the configured branch, using HTTPS in the build container so
          // checkout does not require copying private SSH/known-host files.
          def revision = checkout([$class: 'GitSCM', branches: scm.branches,
            userRemoteConfigs: [[url: 'https://github.com/Posten-Lab/happy-that-works.git']]])
          env.GIT_BRANCH = revision.GIT_BRANCH
          env.GIT_COMMIT = revision.GIT_COMMIT
          if (!(env.GIT_COMMIT ==~ /[0-9a-f]{40}/)) error('An exact checkout commit is required')
          if (!params.VALIDATE_ONLY && (env.CHANGE_ID || !(env.GIT_BRANCH in ['main', 'origin/main'])))
            error('Production deployment requires a main-branch checkout')
          def actual = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
          if (actual != env.GIT_COMMIT) error('Checkout revision mismatch')
        }
      }
    }
    stage('Verify') {
      steps {
        sh '''
          sh deploy/talos-production/prepare-ci.sh kubectl
          node scripts/verify-release-config.cjs web
            SKIP_TALOS_WIRE_BUILD=1 pnpm install --frozen-lockfile --filter @ahmadposten/talos-server... \
              --config.node-linker=isolated --config.shamefully-hoist=false
            pnpm verify:brand
            node --test deploy/talos-production/release-component.test.cjs
            pnpm --filter @ahmadposten/talos-wire test
            pnpm --filter @ahmadposten/talos-server typecheck
            pnpm --filter @ahmadposten/talos-server exec vitest run --maxWorkers=4
        '''
      }
    }
    stage('Build and push immutable image') {
      when { expression { return !params.VALIDATE_ONLY } }
      options { timeout(time: 40, unit: 'MINUTES') }
      steps {
        container('kaniko') {
          sh '''
            /kaniko/executor \
              --context="dir://$WORKSPACE" \
              --dockerfile=Dockerfile.server \
              --destination="ahmadposten/talos-server:git-$GIT_COMMIT-$BUILD_NUMBER" \
              --digest-file="$WORKSPACE/image-digest.txt" \
              --snapshot-mode=redo --push-retry=2
          '''
        }
      }
    }
    stage('Deploy and verify public revision') {
      when { expression { return !params.VALIDATE_ONLY } }
      steps {
        sh '''
          IMAGE="ahmadposten/talos-server@$(cat image-digest.txt)"
          node deploy/talos-production/release-component.cjs api "$IMAGE" "$GIT_COMMIT" release-evidence
        '''
        script { currentBuild.description = "deployed:${env.GIT_COMMIT}" }
      }
    }
  }
  post {
    unsuccessful {
      // Normal health failures roll back inside the helper. This also recovers
      // a pending release if Jenkins interrupted a stage after the patch.
      sh '''
        if [ -f release-evidence/release.json ] && [ -f image-digest.txt ]; then
          IMAGE="ahmadposten/talos-server@$(cat image-digest.txt)"
          node deploy/talos-production/release-component.cjs api "$IMAGE" "$GIT_COMMIT" release-evidence --recover
        fi
      '''
    }
    always {
      archiveArtifacts artifacts: 'release-evidence/*.json,image-digest.txt', allowEmptyArchive: true
      cleanWs()
    }
  }
}
