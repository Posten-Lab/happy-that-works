{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "talos-api",
        "namespace": "happy",
        "labels": {
          "app": "talos-api",
          "product": "talos"
        }
      },
      "spec": {
        "replicas": 2,
        "strategy": {
          "rollingUpdate": {
            "maxSurge": 1,
            "maxUnavailable": 0
          },
          "type": "RollingUpdate"
        },
        "selector": {
          "matchLabels": {
            "app": "talos-api",
            "product": "talos"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "talos-api",
              "product": "talos"
            },
            "annotations": {
              "prometheus.io/scrape": "true",
              "prometheus.io/port": "9090",
              "prometheus.io/path": "/metrics"
            }
          },
          "spec": {
            "containers": [
              {
                "env": [
                  {
                    "name": "NODE_ENV",
                    "value": "production"
                  },
                  {
                    "name": "PORT",
                    "value": "3005"
                  },
                  {
                    "name": "DB_PROVIDER",
                    "value": "postgres"
                  },
                  {
                    "name": "REDIS_URL",
                    "value": "redis://happy-redis:6379"
                  },
                  {
                    "name": "S3_HOST",
                    "value": "files.talosapp.ai"
                  },
                  {
                    "name": "S3_PORT",
                    "value": "443"
                  },
                  {
                    "name": "S3_USE_SSL",
                    "value": "true"
                  },
                  {
                    "name": "S3_REGION",
                    "value": "us-east-1"
                  },
                  {
                    "name": "S3_BUCKET",
                    "value": "happy"
                  },
                  {
                    "name": "S3_PUBLIC_URL",
                    "value": "https://files.talosapp.ai/happy"
                  },
                  {
                    "name": "PUBLIC_URL",
                    "value": "https://api.talosapp.ai"
                  },
                  {
                    "name": "METRICS_ENABLED",
                    "value": "true"
                  },
                  {
                    "name": "TALOS_WEBAPP_URL",
                    "value": "https://talosapp.ai"
                  }
                ],
                "envFrom": [
                  {
                    "secretRef": {
                      "name": "happy-server-secret"
                    }
                  }
                ],
                "image": "__TALOS_API_IMAGE__",
                "imagePullPolicy": "IfNotPresent",
                "livenessProbe": {
                  "failureThreshold": 3,
                  "httpGet": {
                    "path": "/v1/status",
                    "port": 3005,
                    "scheme": "HTTP"
                  },
                  "initialDelaySeconds": 30,
                  "periodSeconds": 20,
                  "successThreshold": 1,
                  "timeoutSeconds": 5
                },
                "name": "talos-api",
                "ports": [
                  {
                    "containerPort": 3005,
                    "name": "http",
                    "protocol": "TCP"
                  },
                  {
                    "containerPort": 9090,
                    "name": "metrics",
                    "protocol": "TCP"
                  }
                ],
                "readinessProbe": {
                  "failureThreshold": 3,
                  "httpGet": {
                    "path": "/health",
                    "port": 3005,
                    "scheme": "HTTP"
                  },
                  "initialDelaySeconds": 10,
                  "periodSeconds": 10,
                  "successThreshold": 1,
                  "timeoutSeconds": 5
                },
                "resources": {
                  "limits": {
                    "cpu": "2",
                    "memory": "1536Mi"
                  },
                  "requests": {
                    "cpu": "100m",
                    "memory": "384Mi"
                  }
                },
                "lifecycle": {
                  "preStop": {
                    "exec": {
                      "command": [
                        "sh",
                        "-c",
                        "sleep 10"
                      ]
                    }
                  }
                },
                "startupProbe": {
                  "httpGet": {
                    "path": "/health",
                    "port": 3005
                  },
                  "periodSeconds": 5,
                  "failureThreshold": 60,
                  "timeoutSeconds": 3
                }
              }
            ],
            "dnsPolicy": "ClusterFirst",
            "initContainers": [
              {
                "command": [
                  "sh",
                  "-c",
                  "until nc -z happy-postgres 5432; do echo waiting for postgres; sleep 2; done"
                ],
                "image": "busybox:1.36",
                "imagePullPolicy": "IfNotPresent",
                "name": "wait-postgres",
                "resources": {}
              }
            ],
            "restartPolicy": "Always",
            "schedulerName": "default-scheduler",
            "securityContext": {},
            "terminationGracePeriodSeconds": 60,
            "affinity": {
              "podAntiAffinity": {
                "requiredDuringSchedulingIgnoredDuringExecution": [
                  {
                    "labelSelector": {
                      "matchLabels": {
                        "app": "talos-api",
                        "product": "talos"
                      }
                    },
                    "topologyKey": "kubernetes.io/hostname"
                  }
                ]
              }
            }
          }
        },
        "minReadySeconds": 10,
        "progressDeadlineSeconds": 600
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "talos-api",
        "namespace": "happy",
        "labels": {
          "app": "talos-api",
          "product": "talos"
        }
      },
      "spec": {
        "type": "NodePort",
        "selector": {
          "app": "talos-api",
          "product": "talos"
        },
        "ports": [
          {
            "name": "http",
            "port": 3005,
            "targetPort": 3005,
            "nodePort": 32002
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "talos-web",
        "namespace": "happy",
        "labels": {
          "app": "talos-web",
          "product": "talos"
        }
      },
      "spec": {
        "replicas": 2,
        "strategy": {
          "rollingUpdate": {
            "maxSurge": 1,
            "maxUnavailable": 0
          },
          "type": "RollingUpdate"
        },
        "selector": {
          "matchLabels": {
            "app": "talos-web",
            "product": "talos"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "talos-web",
              "product": "talos"
            }
          },
          "spec": {
            "containers": [
              {
                "image": "__TALOS_WEB_IMAGE__",
                "imagePullPolicy": "IfNotPresent",
                "livenessProbe": {
                  "failureThreshold": 3,
                  "httpGet": {
                    "path": "/",
                    "port": 80,
                    "scheme": "HTTP"
                  },
                  "initialDelaySeconds": 15,
                  "periodSeconds": 20,
                  "successThreshold": 1,
                  "timeoutSeconds": 5
                },
                "name": "talos-web",
                "ports": [
                  {
                    "containerPort": 80,
                    "name": "http",
                    "protocol": "TCP"
                  }
                ],
                "readinessProbe": {
                  "failureThreshold": 3,
                  "httpGet": {
                    "path": "/",
                    "port": 80,
                    "scheme": "HTTP"
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 10,
                  "successThreshold": 1,
                  "timeoutSeconds": 3
                },
                "resources": {
                  "limits": {
                    "cpu": "200m",
                    "memory": "128Mi"
                  },
                  "requests": {
                    "cpu": "20m",
                    "memory": "32Mi"
                  }
                },
                "lifecycle": {
                  "preStop": {
                    "exec": {
                      "command": [
                        "sh",
                        "-c",
                        "sleep 10"
                      ]
                    }
                  }
                },
                "startupProbe": {
                  "httpGet": {
                    "path": "/",
                    "port": 80
                  },
                  "periodSeconds": 5,
                  "failureThreshold": 60,
                  "timeoutSeconds": 3
                }
              }
            ],
            "dnsPolicy": "ClusterFirst",
            "restartPolicy": "Always",
            "schedulerName": "default-scheduler",
            "securityContext": {},
            "terminationGracePeriodSeconds": 60,
            "affinity": {
              "podAntiAffinity": {
                "requiredDuringSchedulingIgnoredDuringExecution": [
                  {
                    "labelSelector": {
                      "matchLabels": {
                        "app": "talos-web",
                        "product": "talos"
                      }
                    },
                    "topologyKey": "kubernetes.io/hostname"
                  }
                ]
              }
            }
          }
        },
        "minReadySeconds": 10,
        "progressDeadlineSeconds": 600
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "talos-web",
        "namespace": "happy",
        "labels": {
          "app": "talos-web",
          "product": "talos"
        }
      },
      "spec": {
        "type": "NodePort",
        "selector": {
          "app": "talos-web",
          "product": "talos"
        },
        "ports": [
          {
            "name": "http",
            "port": 80,
            "targetPort": 80,
            "nodePort": 32001
          }
        ]
      }
    }
  ]
}
