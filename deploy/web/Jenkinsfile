pipeline {
  // One pod, three containers sharing the workspace:
  //   node   — builds the Expo web export at full CPU (Metro is CPU-bound)
  //   kaniko — packages ONLY the small web-dist into an nginx image
  //   jnlp   — checkout + kubectl (kubectl-capable agent image)
  // The old design ran the whole build inside kaniko, so kaniko snapshotted
  // the monorepo node_modules after every RUN -> ~40 min. Building in node and
  // letting kaniko touch only ~40 MB of static output fixes that.
  agent {
    kubernetes {
      yaml '''
apiVersion: v1
kind: Pod
spec:
  serviceAccountName: jenkins
  nodeSelector:
    site: onprem2
  tolerations:
    - key: dedicated
      operator: Equal
      value: ci
      effect: NoSchedule
  containers:
    - name: jnlp
      image: ahmadposten/jenkins-agent-kubectl:latest
      resources:
        requests: { cpu: "200m", memory: "512Mi" }
        limits: { cpu: "1", memory: "1Gi" }
    - name: node
      image: node:20-alpine
      command: ["cat"]
      tty: true
      resources:
        requests: { cpu: "6", memory: "6Gi" }
        limits: { cpu: "16", memory: "16Gi" }
    - name: kaniko
      image: gcr.io/kaniko-project/executor:debug
      command: ["/busybox/cat"]
      tty: true
      volumeMounts:
        - name: dockerhub
          mountPath: /kaniko/.docker
      resources:
        requests: { cpu: "1", memory: "2Gi" }
        limits: { cpu: "4", memory: "4Gi" }
  volumes:
    - name: dockerhub
      secret:
        secretName: dockerhub-credentials
'''
      defaultContainer 'node'
    }
  }

  options {
    timeout(time: 30, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '20'))
    disableConcurrentBuilds()
    // We do our own HTTPS checkout below (public repo, no SSH host keys),
    // so skip the implicit SSH scm checkout that runs on the pod.
    skipDefaultCheckout()
  }

  stages {
    stage('Checkout') {
      options { retry(3) }
      steps {
        // HTTPS clone of the public repo — no SSH, no known_hosts. A bare
        // checkout() step does NOT populate env.GIT_COMMIT; capture its
        // return value for the image tag / GIT_SHA stamp below.
        script {
          def scmVars = checkout scm
          env.GIT_COMMIT = scmVars.GIT_COMMIT
        }
      }
    }

    // No 'Ensure Namespace' stage: namespaces are cluster-scoped and the
    // Jenkins SA only has a namespaced deployer Role in `talos` (which already
    // exists — created at setup, tracked in deploy/web/k8s/namespace.yaml).

    stage('Build web bundle') {
      // node container. pnpm store lands in the workspace so it survives
      // within the build; expo export runs Metro at up to 16 CPU.
      steps {
        container('node') {
          sh '''
            set -e
            export COREPACK_HOME=/tmp/corepack
            mkdir -p /tmp/pnpm-bin
            corepack enable --install-directory /tmp/pnpm-bin pnpm
            export PATH=/tmp/pnpm-bin:$PATH
            corepack prepare pnpm@10.11.0 --activate
            export APP_ENV=production NODE_ENV=production SHARP_IGNORE_GLOBAL_LIBVIPS=1
            # isolated linker + filter: install only the talos-app subgraph
            # (excludes talos-desktop/node-pty), matching Dockerfile.webapp.
            SKIP_TALOS_WIRE_BUILD=1 pnpm install --frozen-lockfile --filter talos-app... \
              --config.node-linker=isolated --config.shamefully-hoist=false
            node scripts/verify-release-config.cjs web
            node scripts/render-deployment.cjs deploy/web/k8s deploy/rendered/web
            pnpm --filter @talos/wire build
            pnpm --filter talos-app exec expo export --platform web --output-dir web-dist
          '''
        }
      }
    }

    stage('Package & Push') {
      // kaniko snapshots only web-dist + nginx base. Fast.
      options { retry(3) }
      steps {
        container('kaniko') {
          script {
            def shortSha = env.GIT_COMMIT ? env.GIT_COMMIT.take(7) : 'unknown'
            sh """/kaniko/executor \
              --context=dir://${WORKSPACE} \
              --dockerfile=${WORKSPACE}/deploy/web/Dockerfile.package \
              --destination=ahmadposten/talos-web:latest \
              --destination=ahmadposten/talos-web:git-${shortSha} \
              --cache=true \
              --cache-repo=ahmadposten/talos-web-cache"""
          }
        }
      }
    }

    stage('Deploy') {
      options { retry(3) }
      steps {
        container('jnlp') {
          script {
            def shortSha = env.GIT_COMMIT ? env.GIT_COMMIT.take(7) : 'unknown'
            def buildTimeIso = new Date().format("yyyy-MM-dd'T'HH:mm:ssXXX", TimeZone.getTimeZone('UTC'))
            sh """
              f=deploy/rendered/web/deployment.yaml
              sed -i "s|__GIT_SHA__|${shortSha}|g" "\$f"
              sed -i "s|__BUILD_TIME__|${buildTimeIso}|g" "\$f"
            """
          }
          sh 'kubectl apply -f deploy/rendered/web/service.yaml -n talos'
          sh 'kubectl apply -f deploy/rendered/web/deployment.yaml -n talos'
          sh 'kubectl rollout restart deployment/talos-web -n talos'
          sh 'kubectl rollout status deployment/talos-web -n talos --timeout=300s'
        }
      }
    }
  }

  post {
    always {
      // The isolated pnpm install links read-only files into node_modules;
      // make them writable first so cleanup can't fail the build.
      sh 'chmod -R u+w "$WORKSPACE" 2>/dev/null; rm -rf "$WORKSPACE"/* "$WORKSPACE"/.[!.]* 2>/dev/null; true'
    }
  }
}
